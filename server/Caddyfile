nutblast.schwung.us, nutblaster.schwung.us {
	@websocket {
		path /
		header Connection *Upgrade*
		header Upgrade websocket
	}

	route {
		rewrite @websocket /v1
		reverse_proxy /v1* 127.0.0.1:36900
		redir https://github.com/Schwungus/NutBlast
	}
}

nutpunch.schwung.us, nutpuncher.schwung.us {
	redir https://github.com/Schwungus/NutPunch
}
