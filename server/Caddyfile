nutblast.schwung.us, nutblaster.schwung.us {
	route {
		handle_path /v1* {
			reverse_proxy 127.0.0.1:36900 {
				header_up Host {http.request.host}
				header_up X-Real-IP {http.request.remote}
			}
		}

		redir https://github.com/Schwungus/NutBlast
	}
}

