Checks: [
    clang-analyzer-*,
    bugprone-*,
    -bugprone-easily-swappable-parameters,
    -bugprone-integer-division,
    -bugprone-empty-catch, # nothing but false positives
    -bugprone-throwing-static-initialization, # every `static` string is a warning but i'm not falling back to `const char*`!!!!
    performance-*,
    -performance-enum-size, # suggested fix is not portable across GCC/Clang/MSVC
    portability-*,
    misc-*,
    -misc-non-private-member-variables-in-classes, # L: reports `struct` members should be private
    cppcoreguidelines-init-variables,
  ]
